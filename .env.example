GEMINI_API_KEY=AIzaSy...         ← your Gemini key from Google AI Studio
GROQ_API_KEY=gsk_...             ← your Groq key from console.groq.com
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_pass       ← choose any password, this is local only
POSTGRES_DB=rag_db
DATABASE_URL=postgresql://rag_user:rag_pass@localhost:5432/rag_db
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local cross-encoder used only when Hybrid + Reranker is selected.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# These settings are used only by `python -m evals.runner --mode full`.
# Keep them separate so the evaluator can use a different model/provider from
# the Groq model whose RAG answers it is judging.
EVAL_LLM_PROVIDER=openai
EVAL_LLM_MODEL=gpt-4o-mini
EVAL_LLM_API_KEY=your_evaluator_key
# RAGAS structured responses can exceed its library default of 1024 tokens.
EVAL_LLM_MAX_TOKENS=4096
# EVAL_LLM_BASE_URL=https://optional-openai-compatible-endpoint/v1
EVAL_EMBEDDING_PROVIDER=openai
EVAL_EMBEDDING_MODEL=text-embedding-3-small
EVAL_EMBEDDING_API_KEY=your_evaluator_key
# EVAL_EMBEDDING_BASE_URL=https://optional-openai-compatible-endpoint/v1
